; Based on the Simple Audio Sample from Windows-driver-samples (MS-PL).

[Version]
Signature   = "$Windows NT$"
Class       = MEDIA
ClassGUID   = {4d36e96c-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
DriverVer   = 01/01/2026, 1.0.0.0
CatalogFile = litzaudio.cat
PnpLockDown = 1

[SourceDisksNames]
222 = %DiskName%,"",222

[SourceDisksFiles]
litzaudio.sys = 222

[Manufacturer]
%MfgName% = LitzAudio, NT$ARCH$.10.0...19041

[LitzAudio.NT$ARCH$.10.0...19041]
%LitzAudio.DeviceDesc% = LitzAudio_Device, ROOT\LitzAudio

[DestinationDirs]
LitzAudio.CopyList = 13

[LitzAudio.CopyList]
litzaudio.sys

[LitzAudio.AddReg]
HKR,,AssociatedFilters,,"wdmaud,swmidi,redbook"
HKR,,Driver,,litzaudio.sys
HKR,%MediaCategories%\%MicrophoneNameGuid%,Name,,%LitzAudio.Microphone%
HKR,Drivers,SubClasses,,"wave,midi,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\midi\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%LitzAudio.DeviceDesc%
HKR,Drivers\mixer\wdmaud.drv,Description,,%LitzAudio.DeviceDesc%

[LitzAudio_Device.NT]
Include = ks.inf, wdmaudio.inf
Needs = KS.Registration, WDMAUDIO.Registration
CopyFiles = LitzAudio.CopyList
AddReg = LitzAudio.AddReg

[LitzAudio_Device.NT.Interfaces]
AddInterface = %KSCATEGORY_AUDIO%, %KSNAME_WaveMicrophone%, LitzAudio.I.WaveMicrophone
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_WaveMicrophone%, LitzAudio.I.WaveMicrophone
AddInterface = %KSCATEGORY_CAPTURE%, %KSNAME_WaveMicrophone%, LitzAudio.I.WaveMicrophone
AddInterface = %KSCATEGORY_AUDIO%, %KSNAME_TopologyMicrophone%, LitzAudio.I.TopologyMicrophone
AddInterface = %KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyMicrophone%, LitzAudio.I.TopologyMicrophone

[LitzAudio.I.WaveMicrophone]
AddReg = LitzAudio.I.WaveMicrophone.AddReg

[LitzAudio.I.WaveMicrophone.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%LitzAudio.Microphone%

[LitzAudio.I.TopologyMicrophone]
AddReg = LitzAudio.I.TopologyMicrophone.AddReg

[LitzAudio.I.TopologyMicrophone.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%LitzAudio.Microphone%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1

[LitzAudio_Device.NT.Services]
AddService = LitzAudio, 0x00000002, LitzAudio_Service

[LitzAudio_Service]
DisplayName = %LitzAudio.ServiceDesc%
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %13%\litzaudio.sys

[LitzAudio_Device.NT.HW]
AddReg = LitzAudio.HW.AddReg

[LitzAudio.HW.AddReg]
HKR,,DeviceType,0x10001,0x0000001D
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"

[Strings]
KSNAME_WaveMicrophone = "WaveMicrophone"
KSNAME_TopologyMicrophone = "TopologyMicrophone"
Proxy.CLSID = "{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO = "{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_CAPTURE = "{65E8773D-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME = "{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSCATEGORY_TOPOLOGY = "{DDA54A40-1E4C-11D1-A050-405705C10000}"
KSNODETYPE_ANY = "{00000000-0000-0000-0000-000000000000}"
PKEY_AudioEndpoint_Association = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"
PKEY_AudioEndpoint_Supports_EventDriven_Mode = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},7"
MediaCategories = "MediaCategories"
MicrophoneNameGuid = "{1DD87686-96CF-4275-947D-BDF0BE20934E}"
ProviderName = "Litz Audio"
MfgName = "Litz Audio"
DiskName = "Litz Audio Driver Disk"
LitzAudio.DeviceDesc = "Litz Audio"
LitzAudio.ServiceDesc = "Litz Audio Driver"
LitzAudio.Microphone = "Litz Microphone"
